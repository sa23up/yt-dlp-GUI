!src-tauri/binaries/.gitignore

# Runtime data directory (user-specific)
# Contains settings, queue, logs, cookies, downloaded yt-dlp
.yt-dlp-gui/
*.yt-dlp-gui/

# Environment variables (CRITICAL - NEVER COMMIT)
.env
.env.*
!.env.example

